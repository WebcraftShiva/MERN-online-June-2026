<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <% user.username%>
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="card">

        <!-- user profile section -->
        <div class="profile">
            <img src="<%= user.profile%>" alt="Profile">

            <!-- Information section -->
            <div class="info">
                <!-- username -->
                <h2>
                    <%=user.name%>
                </h2>

                <!-- Profession -->
                <p class="profession">
                    <%=user.profession%>
                </p>

                <% user.bio.forEach(line=>{ %>
                    <p>
                        <%= line %>
                    </p>
                    <%}) %>

                        <a href="https://<%= user.website %>">
                            <%= user.website%>
                        </a>
            </div>
        </div>

        <div class="stats">
            <div class="">
                <strong>
                    <%= user.post %>
                </strong>
            </div>
            <span>Posts</span>

            <div class="">
                <strong>
                    <%= user.followes %>
                </strong>
            </div>
            <span>Followes</span>

            <div class="">
                <strong>
                    <%= user.followings %>
                </strong>
            </div>
            <span>Followings</span>


        </div>
    </div>
</body>

</html>