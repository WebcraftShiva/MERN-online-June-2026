<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Form</title>
</head>

<body>

    <h2>Create New Post</h2>

    <form action="/posts" method="post">

        <input type="text" name="" id="" placeholder="enter our username" name="username">
        <br>
        <br>
        <textarea name="" id="" placeholder="write your post" name="content"></textarea>

        <button type="submit">Submit Form</button>
    </form>

</body>

</html>